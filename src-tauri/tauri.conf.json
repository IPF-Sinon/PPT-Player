{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PPTPlayer",
  "version": "1.2.0",
  "identifier": "com.ipf.sinon.pptplayer",
  "mainBinaryName": "PPTPlayer",
  "build": {
    "frontendDist": "../out/renderer"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "PPT 放映器",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: http://pptx.localhost http://deck.localhost; media-src 'self' blob: http://pptx.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://deck.localhost http://pptx.localhost; font-src 'self' data:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": [
      "../resources/engine.json"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "pptx",
          "pptm",
          "ppsx",
          "ppsm",
          "potx"
        ],
        "name": "PowerPoint 演示文稿",
        "description": "PowerPoint 演示文稿",
        "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "role": "Editor"
      },
      {
        "ext": [
          "ppt",
          "pps",
          "pot"
        ],
        "name": "PowerPoint 97-2003 演示文稿",
        "description": "旧版 PowerPoint 演示文稿",
        "mimeType": "application/vnd.ms-powerpoint",
        "role": "Editor"
      },
      {
        "ext": [
          "odp"
        ],
        "name": "OpenDocument 演示文稿",
        "description": "OpenDocument 演示文稿",
        "mimeType": "application/vnd.oasis.opendocument.presentation",
        "role": "Editor"
      },
      {
        "ext": [
          "docx",
          "docm",
          "dotx"
        ],
        "name": "Word 文档",
        "description": "Word 文档",
        "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "role": "Editor"
      },
      {
        "ext": [
          "doc",
          "dot"
        ],
        "name": "Word 97-2003 文档",
        "description": "旧版 Word 文档",
        "mimeType": "application/msword",
        "role": "Editor"
      },
      {
        "ext": [
          "xlsx",
          "xlsm",
          "xltx"
        ],
        "name": "Excel 工作簿",
        "description": "Excel 工作簿",
        "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        "role": "Editor"
      },
      {
        "ext": [
          "xls",
          "xlt"
        ],
        "name": "Excel 97-2003 工作簿",
        "description": "旧版 Excel 工作簿",
        "mimeType": "application/vnd.ms-excel",
        "role": "Editor"
      },
      {
        "ext": [
          "csv",
          "tsv"
        ],
        "name": "CSV 表格",
        "description": "逗号分隔的表格文件",
        "mimeType": "text/csv",
        "role": "Editor"
      },
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF 文档",
        "description": "PDF 文档",
        "mimeType": "application/pdf",
        "role": "Editor"
      }
    ]
  }
}
