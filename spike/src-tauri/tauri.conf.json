{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PPTPlayerSpike",
  "version": "0.1.0",
  "identifier": "com.ipf.sinon.pptspike",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "title": "PPTPlayer Spike",
        "width": 1100,
        "height": 760,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}