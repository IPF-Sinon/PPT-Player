{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": [
        "src/shared/*"
      ],
      "@main/*": [
        "src-tauri/*"
      ]
    }
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "src/shared/**/*",
    "tests/unit/**/*",
    "tests/helpers/**/*",
    "tests/e2e/**/*"
  ],
  "exclude": [
    "tests/unit/pptx-animations.test.ts",
    "tests/unit/pptx-parse.test.ts",
    "tests/unit/pptx-animated-fixture.test.ts",
    "tests/unit/tabs.test.ts",
    "tests/unit/pptx-motion.test.ts",
    "tests/unit/pptx-trigger-eval.test.ts",
    "tests/unit/pptx-trigger-fixture.test.ts",
    "tests/unit/pptx-exit.test.ts",
    "tests/unit/ink-history.test.ts",
    "tests/unit/docx-parse.test.ts",
    "tests/unit/docx-registry.test.ts"
  ]
}