{
  "name": "ppt-player",
  "version": "1.1.0",
  "description": "Windows desktop player for PowerPoint / OpenDocument presentations",
  "author": "PolarNight",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/copy-pdfjs-assets.mjs && vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:pptx": "tsc --noEmit -p tsconfig.pptx.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:pptx",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "package": "npm run package:lite",
    "package:full": "npm run build && tauri build --config src-tauri/tauri.full.conf.json --bundles nsis",
    "package:lite": "npm run build && tauri build --config src-tauri/tauri.conf.json --bundles nsis",
    "fixtures": "node scripts/make-fixtures.mjs",
    "tauri:dev": "tauri dev"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "cfb": "1.2.2",
    "eslint": "9.39.5",
    "fflate": "0.8.3",
    "jsdom": "^31.0.1",
    "pdfjs-dist": "6.5.438",
    "png-to-ico": "3.0.2",
    "pptxgenjs": "4.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "zustand": "5.1.0"
  }
}
